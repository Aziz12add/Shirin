# Server Configuration
PORT=8080
NODE_ENV=production

# Admin Authentication
ADMIN_USER=admin
ADMIN_PASS=change_this_strong_password
SESSION_SECRET=change_this_to_a_random_secure_hex_secret_at_least_32_chars

# Public Host for subscription links
PUBLIC_HOST=

# Database
DATABASE_URL=

# Proxy Performance & DPI Bypass
PROXY_MAX_CONNS=1000
PROXY_MAX_CONNS_PER_USER=300
PROXY_HWM=65536
PROXY_WS_BUFFERED=524288
PROXY_MEM_SOFT=400M
PROXY_MEM_HARD=480M
PROXY_IDLE_MS=600000
PROXY_PING_MS=25000
PROXY_AUTH_MS=15000
PROXY_CONNECT_MS=15000
PROXY_PREFER_IPV6=0
PROXY_UDP_DNS_PORTS=53
ALLOW_PRIVATE_TARGETS=0
STRICT_PATHS=0
PROXY_HOPS=1
PROXY_RANDOMIZE_PACKETS=0
PROXY_FAKE_HEADERS=0

# Rate Limiting
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW=60000
