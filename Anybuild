load("//anybuild/tools:node.bzl", "node_build", "node_config", "node_serve")

config = node_config(
    schema = 1,

    commands = {
        "start": "node dist/server.cjs",
    },

    node_version = "24",
    node_package_manager = "bun",

    # Express is the server runtime
    node_server = "node",

    # Vite is the frontend framework/build system
    node_framework = "vite",

    node_build_command = "bun run build",
)

build = node_build(config)

node_serve(
    config,
    build,
    name = "shirin",
    extra_env = {
        "NODE_ENV": "production",
    },
)
