{
  "name": "shirin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RayPanel – Proxy & Subscription Management Panel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aziz12add/Shirin.git"
  },
  "engines": { "node": ">=20" },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "tsx watch --env-file=.env server.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --target=node20 --minify --external:vite --external:pg-native --external:bufferutil --external:utf-8-validate --outfile=dist/server/server.cjs",
    "prestart": "node -e \"require('fs').existsSync('dist/server/server.cjs')||process.exit(1)\"",
    "start": "node --env-file=.env dist/server/server.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "deploy": "npm run build && wasmer deploy"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.23.0",
    "ws": "^8.21.3",
    "helmet": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "zod": "^3.24.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    /* حذف autoprefixer */
    /* @google/genai فقط اگر واقعاً dev-only است */
    /* افزودن: eslint, prettier, vitest, @vitest/coverage-v8, supertest, @types/supertest */
  }
}
